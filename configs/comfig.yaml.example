# 邮件服务
email:
  email_name: xxx@163.com
  email_password: # 应用密码，非邮箱密码

# 邮件服务商
smtp_server:
  SMTPServer_host: smtp.163.com # 服务提供商，须与email中的邮箱相匹配
  SMTPServer_port: 465

kafka:
  brokers: "localhost:9092,localhost:9093,localhost:9094" # 多个broker用逗号','分割
  topic:  # 邮箱事件主题

# 邮件发送配置
max_retries: 3 # 最大重试次数

zlog:
  # 日志级别: debug, info, warn, error, panic, fatal
  level: info
  # 输出目标: console, file, both
  output: both
  # 控制台格式: json, console
  format: json
  # 日志文件路径，output 为 console 时不生效
  file_path: ./logs/email-service.log
  # 单个日志文件最大大小(MB)
  max_size: 100
  # 保留的最大日志文件数
  max_backups: 10
  # 保留的最大天数
  max_age: 30
  # 是否压缩旧日志文件
  compress: true
  # 是否启用日志采样
  sampling: false
  